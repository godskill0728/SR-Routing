# Local preview is deliberately disconnected. No default passwords or API keys.
HOST=127.0.0.1
PORT=8080
ENVOY_URL_ON=http://127.0.0.1:9
ENVOY_URL_OFF=http://127.0.0.1:9
ROUTER_HEALTH_URL_ON=http://127.0.0.1:9/health
ROUTER_HEALTH_URL_OFF=http://127.0.0.1:9/health
EVAL_URL_ON=http://127.0.0.1:9/api/v1/eval
EVAL_URL_OFF=http://127.0.0.1:9/api/v1/eval
JAEGER_TRACE_URL=http://127.0.0.1:9/api/traces/
TRACE_SERVICE_ON=sr-demo-on
TRACE_SERVICE_OFF=sr-demo-off
ENABLE_AMX_CONTROL=false
# Set these externally in a secret manager, never commit actual values:
# LITELLM_API_KEY, PROXY_MASTER_KEY (same key for SR -> LiteLLM)
# EASY_API_KEY, MEDIUM_API_KEY, HARD_API_KEY
# EASY_API_BASE, MEDIUM_API_BASE, HARD_API_BASE (OpenAI-compatible /v1 URLs)